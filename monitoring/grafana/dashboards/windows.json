{
  "uid": "windows",
  "title": "Windows PC",
  "tags": [
    "monitoring"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "monitoring"
      ],
      "asDropdown": true,
      "title": "Monitoring",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "hide": 0,
        "query": {
          "query": "label_values(windows_os_info, instance)",
          "refId": "instance"
        },
        "definition": "label_values(windows_os_info, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
