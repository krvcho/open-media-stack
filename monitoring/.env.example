# Settings of the monitoring stack. Copy to .env (git-ignored) or paste into Portainer's environment variables.

# Grafana's admin password (user: admin). Required. Generate one, e.g. `openssl rand -base64 18`.
GRAFANA_ADMIN_PASSWORD=

# Grafana's port and the address it listens on. 0.0.0.0 = the LAN (and the tailnet, if the host runs Tailscale);
# 127.0.0.1 = this machine only.
GRAFANA_PORT=3000
GRAFANA_BIND=0.0.0.0

# How long metrics and logs are kept (Prometheus and Loki duration syntax), and the most disk Prometheus may use;
# the older data goes first when either limit is hit. Loki has only the time limit; Docker's own container logs
# are capped at 3 x 10 MB per container in compose.yaml.
METRICS_RETENTION=15d
METRICS_RETENTION_SIZE=5GB
LOGS_RETENTION=168h

# Telegram alerts (docs/install/09-monitoring.md). Empty token = no messages, alerts stay in Grafana.
# The token comes from @BotFather; the chat id is a number (negative for a group).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Quiet hours (23:00-08:00) and the daily heartbeat (10:00) use this zone, e.g. Europe/Warsaw.
ALERT_TIMEZONE=UTC
# Optional link at the end of every message, e.g. http://192.0.2.10:3000. Empty = no link.
GRAFANA_URL=

# Machines outside Docker to scrape, as a JSON list of Prometheus targets; empty = none. A Windows PC running
# windows_exporter (docs/install/09-monitoring.md):
# EXTRA_TARGETS=[{"__address__":"192.0.2.20:9182","instance":"pc","job":"windows"}]
EXTRA_TARGETS=

# A host directory with *.prom files that jobs on the host write, such as a backup's last success
# (docs/install/09-monitoring.md). Put /rootfs in front of the host path; empty = none.
# TEXTFILE_DIR=/rootfs/var/lib/prometheus/node-exporter
TEXTFILE_DIR=

# Addresses to request every 30 s, as a JSON list, for services without metrics; empty = none.
# HTTP_PROBES=[{"__address__":"http://127.0.0.1:8085/health","name":"notes","module":"http_2xx"}]
HTTP_PROBES=
