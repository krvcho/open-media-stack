# Configuration for media-stack. Copy to `.env` (git-ignored), then `chmod 600 .env`.
# Never commit `.env`. Each variable says what it is and whether it is a secret.

# SECRET. Household access token: part of every client URL. At least 32 characters.
# Generate: openssl rand -hex 32
HOUSEHOLD_TOKEN=

# SECRET. Prowlarr API key, given to Prowlarr and to the gateway; never to clients.
# Generate: openssl rand -hex 16
PROWLARR_API_KEY=

# SECRET. The household's Lampac account: every device sends it with sync requests, and Lampac serves only
# requests that carry it. Must differ from HOUSEHOLD_TOKEN.
# Generate: openssl rand -hex 16
LAMPAC_HOUSEHOLD_ID=

# SECRET. Your TMDB credential (install step 4): the API key (v3) or the read access token (v4). The gateway
# proxies and caches TMDB with it, so clients never call TMDB's API. Empty = Lampa uses its own key.
TMDB_API_KEY=

# Online sources: set to 1 to load Lampac's online modules and its online plugin in Lampa; leave
# empty to keep them off (the default). Providers are Lampac's; this repository configures none.
ONLINE_SOURCES=

# Online sources to turn off, by the name Lampac lists them under, comma-separated (letters, digits, _); empty =
# none. For a source that fails on your network or player. Kept out of git on purpose.
LAMPAC_DISABLED_SOURCES=

# SECRET. The one TorrServer account; only the gateway uses it.
TORRSERVER_USER=gateway
# Generate: openssl rand -hex 24
TORRSERVER_PASSWORD=

# TorrServer settings the gateway enforces. RAM cache in MB. Upload cap in KB/s: 0 keeps upload
# off (default); for example 125 allows 1 Mbit/s. Changing them stops whatever is playing at that moment.
TORRSERVER_CACHE_MB=512
TORRSERVER_UPLOAD_KB=0
# TorrServer's memory limit. It holds a cache per stream: about 1.2 GB per concurrent stream with the
# default cache; 3200m fits two. Raise it for more streams at once, or for a bigger cache.
TORRSERVER_MEM_LIMIT=3200m

# Host ports. Change them if they collide with other stacks on the host.
GATEWAY_PORT=8080
LAMPAC_PORT=9118
PROWLARR_PORT=9696
# Prowlarr's UI is for setup; 127.0.0.1 keeps it on the host only. Set to the LAN address to reach it from another computer.
PROWLARR_BIND=127.0.0.1

# Time zone for Prowlarr's logs and schedules, e.g. Europe/Warsaw.
TZ=Etc/UTC

# Optional VPN egress for the streaming engine's traffic: add `vpn` to COMPOSE_PROFILES and set
# TORRSERVER_EGRESS=vpn (both, or neither; empty = no VPN). TorrServer then reaches peers and trackers only
# through the tunnel; if the tunnel drops, it has no internet at all. Any WireGuard provider works through
# gluetun: for a provider gluetun knows (e.g. mullvad), set VPN_SERVICE_PROVIDER and the private key and
# address, optionally VPN_SERVER_COUNTRIES; for any other ("custom"), copy every field from the provider's
# WireGuard .conf. The endpoint must be an IP address (resolve the hostname once).
TORRSERVER_EGRESS=
VPN_SERVICE_PROVIDER=custom
VPN_SERVER_COUNTRIES=
# SECRET.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PUBLIC_KEY=
# SECRET.
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_MTU=1420
